# synth_yosys_pnr.ys - netlist for the nextpnr-xilinx P&R trial (run via run_pnr.sh).
# Differences from synth_yosys.ys (the utilisation run):
#   * FFT IP cores replaced by the pass-through stubs in bb/fft_ip_pnr_stub.v (NOT an FFT)
#   * the 116 unconstrained top-level port bits are demoted to internal nets
#     (build/pnr_unconstrained.ys, generated by make_pnr_inputs.py) so the design fits the
#     FTG256 package; their logic is then partly removed by opt_clean
read_verilog -lib -specify +/xilinx/cells_sim.v
read_verilog -lib +/xilinx/cells_xtra.v
read_verilog -defer ../fpga_synth/bb/fft_ip_pnr_stub.v
script ../fpga_synth/build/read_rtl.ys
hierarchy -check -top radar_system_top
setattr -unset ram_style m:long_chirp_i m:long_chirp_q m:short_chirp_i m:short_chirp_q m:doppler_i_mem m:doppler_q_mem
script ../fpga_synth/build/pnr_unconstrained.ys
synth_xilinx -family xc7 -top radar_system_top -flatten -abc9
# $print = DEBUG-gated $display (chirp_memory_loader_param.v:113, DEBUG = 0 but the cell is kept),
# $scopeinfo = hierarchy annotations; nextpnr has no Bel for either
delete t:$print t:$scopeinfo
opt_clean
tee -o ../fpga_synth/reports/yosys_stat_pnr_netlist.txt stat -tech xilinx
write_json ../fpga_synth/build/radar_system_top_beta_pnr.json
